# ─── App URLs ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Client-visible app origin (welcome/verification emails, share links) — usually = APP_URL
NEXT_PUBLIC_APP_URL=

# ─── Database (Postgres / Supabase Toronto) ───────────────────────────────
# Pooled connection (use in app runtime)
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
# Direct connection (use for migrations only)
DATABASE_DIRECT_URL=postgresql://postgres:password@localhost:54322/postgres

# ─── Docs vault storage (Supabase Storage, private bucket 'family-docs') ──────
# The Docs vault stores document bytes in the PRIVATE 'family-docs' bucket, read
# only via short-TTL server-minted signed URLs (rule #1). The server talks to the
# Storage REST API with the SERVICE-ROLE key — SERVER-ONLY, never shipped to the
# client. Operator: create the private bucket before shipping (see the docs-vault
# migration note). URL is the Supabase project URL (https://<ref>.supabase.co).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Auth (Auth.js / NextAuth v5 — Google OAuth) ──────────────────────────
# Secret used to sign the session JWT (e.g. `openssl rand -base64 33`).
# Preview gets its own value. Never copy the Production secret onto Preview.
AUTH_SECRET=
# Google OAuth credentials (also used for Gmail/Calendar integrations below).
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET are set in the Google section below.

# ─── Anthropic ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Vercel AI Gateway key. Required only when a Gateway candidate is enabled.
AI_GATEWAY_API_KEY=
# Prompt-cache layout. Exact string `true` (no trim) sorts tools alphabetically
# and splits skill bodies into separate system blocks. Unset is the production
# default: YAML/code tool order, one concatenated system block. Emitting
# cache_control itself does not wait on this flag.
# PROMPT_CACHE_LAYOUT_ENABLED=
# VIL-376 internal decision steps. Every candidate is default-off; change only
# the reviewed slice to `candidate` when explicitly approved.
HALE_CLASSIFY_EVENT_MODEL_MODE=current
HALE_TRIAGE_MODEL_MODE=current
HALE_REPLY_INTENT_MODEL_MODE=current
HALE_INTAKE_EXTRACT_MODEL_MODE=current
HALE_INBOUND_SCREEN_MODEL_MODE=current
HALE_MEMORY_INFER_MODEL_MODE=current
HALE_VILLAGE_SEARCH_PARSE_MODEL_MODE=current

# ─── Langfuse (prompt management + tracing) ───────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Integrations: Google (Gmail + Calendar + Photos) ─────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# VIL-93. Exact string "true" requests calendar.events and gmail.compose for
# every connect. Leave unset in production.
# GOOGLE_WRITE_SCOPES_ENABLED=
# Comma-separated Hale user ids. While the flag above is unset, only these
# accounts are asked for the extra scopes and only their writes reach Google.
# Linq delivers texts to the production webhook, so a preview URL cannot receive
# a parent text. The verification demo uses this list on production. Empty
# changes nothing.
# GOOGLE_WRITE_SCOPES_ALLOWLIST=
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/hale-gmail-watch
# VIL-226 lane kill switches. Each lane is off unless its value is exactly `true`
# (no trim: set it with printf '%s' true, never a piped echo); unset is the kill.
# TRAVEL_BRIEF_ENABLED is read through the same helper, under its own name.
# Calendar change texts from a connected Google Calendar, and the passport stamps
# inferred from calendar changes.
# CALENDAR_ALERT_ENABLED=
# Mirroring Google Calendar events into family_events, and the reminders they feed.
# PARENT_CALENDAR_MIRROR_ENABLED=
# Texts and offers about parenting email found in a connected Gmail inbox. Off also
# holds the silent booked-detection backfill and the Gmail alert watermark.
# EMAIL_ALERT_ENABLED=
# VIL-433 · the email-alert writer may read the Gmail body for that one compose.
# Strict `true`. Unset is today's facts-only writer. Needs EMAIL_ALERT_ENABLED.
# EMAIL_ALERT_BODY_ENABLED=
# VIL-662 · from a connected Gmail, match a coach/league/TeamSnap schedule
# change to an existing kid event, update the calendar under approval, and tell
# the driver. Strict `true`. Unset is off. The allowlist can name families
# while the global flag is still off.
# TEAM_SCHEDULE_CHANGES_ENABLED=
# TEAM_SCHEDULE_CHANGES_FAMILY_ALLOWLIST=
# The registration ladder (the registration-sequence cron).
# REGISTRATION_LADDER_ENABLED=
# VIL-423 · read a registration window's page before a text states its opening date.
# Exactly `shadow` (read and log, change nothing) or `enforce`; anything else is off.
# REGISTRATION_DATE_CHECK=

# The CONNECTOR client, in its own Google Cloud PROJECT (not a second client inside
# the sign-in project: verification state, the brand review and the 100-new-user
# unverified cap all attach to a project's consent screen). Both or neither — a
# half-set pair falls back to the sign-in client above, which is the pre-VIL-350
# behaviour and still works. Which one a grant used is recorded on the connect audit
# row as oauth_client, and logged once at connect time.
# Authorized redirect URI: <APP_URL>/api/integrations/callback  (exactly, no trailing
# newline — set it with `printf '%s'`, never a piped `echo`)
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=

# Closed-beta invite gate. While BETA_INVITE_ONLY is on (anything but "false"),
# /onboarding requires ?invite=<BETA_INVITE_CODE> (or a prior invite cookie);
# everyone else is sent to the marketing waitlist. Public launch = set
# BETA_INVITE_ONLY=false (one switch). Invite link: <APP_URL>/onboarding?invite=<code>
BETA_INVITE_ONLY=true
BETA_INVITE_CODE=
NEXT_PUBLIC_MARKETING_URL=https://villagehale.com

# ─── Integrations: Microsoft (Outlook + Calendar) ─────────────────────────
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ─── Stripe ───────────────────────────────────────────────────────────────
# Billing is REAL but DORMANT: absent these keys the webhook 501s and the plan-page
# Upgrade CTA stays hidden — behaviour is byte-identical to no billing. Going live
# needs a Stripe account + the four recurring prices (Plus/Family × monthly/annual).
# Sandbox keys first (sk_test_ / whsec_ from `stripe listen`). Do not commit values.
#
# The Payment Link's Dashboard metadata.tier must be plus or family. Set
# STRIPE_PAYMENT_LINK_ID (plink_...) and STRIPE_PAYMENT_LINK_TIER to the same link
# so checkout.session.completed can grant the tier when metadata.tier is absent.
# Webhook: POST /api/webhooks/stripe — verifies Stripe-Signature, then
# checkout.session.completed / invoice.paid / customer.subscription.* write
# families.plan_tier plus stripe_customer_id / stripe_subscription_id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Stripe recurring price ids per tier + period (Plus $9/mo · $79/yr, Family $19/mo ·
# $159/yr CAD). All four must be set for the settings-page checkout to be configured.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_ANNUAL=
STRIPE_PAYMENT_LINK_ID=
# plus or family — required together with STRIPE_PAYMENT_LINK_ID for the webhook
# fallback when the Payment Link session has no metadata.tier.
STRIPE_PAYMENT_LINK_TIER=

# Service/ops alerts (inbound webhook crashes, delivery health) post
# to Slack #ops. They do not text a founder phone, and they do not read
# FOUNDER_ALERT_PHONE. Create an Incoming Webhook bound to #ops
# (channel id C0C5XMCAQ56, workspace hale-p8d7001) and paste the
# https://hooks.slack.com/services/... URL here (Vercel Production, and Preview if
# those crons run). Absence is logged as skipped_not_configured — nobody is paged,
# and no SMS is sent in its place. The same URL is the GitHub Actions secret for
# the cron dead-man workflow.
OPS_SLACK_WEBHOOK_URL=
# Optional. Defaults to C0C5XMCAQ56 (#ops). Slack honors a channel override only
# when the incoming webhook's app allows it; bind the webhook to #ops either way.
SLACK_OPS_CHANNEL=

# ─── Marketing site (apps/site) — public SMS/iMessage line ───────────────
# The number parents text. Linq owns it. E.164 in sms:, tel:, and /hale.vcf.
# Display form is (646) 235-2164. NEXT_PUBLIC_ so it is baked in at site build
# time: set it on the apps/site Vercel project, then redeploy.
# LINQ_FROM_E164 on the web project must be this same E.164.
NEXT_PUBLIC_HALE_SMS_NUMBER=+16462352164

# ─── Linq (iMessage) ──────────────────────────────────────────────────────
# BOTH are required together (apps/web/lib/channel/linq/config.ts). Either one
# missing leaves POST /api/channels/linq/inbound dark (503 linq_not_configured)
# — the process does not crash, and nothing is written. The partner API key
# sends replies; the webhook secret verifies inbound Standard Webhooks
# signatures (whsec_…, shown once when the subscription is created).
# Subscription target (pin the payload version):
#   https://<prod-host>/api/channels/linq/inbound?version=2026-02-03
# subscribed_events — 66 of the 75 types in
# https://docs.linqapp.com/guides/webhooks/events/
# Left off (account/team, not a parent's chat): api_token.created,
# api_token.renamed, api_token.expiry_scheduled, api_token.expired,
# api_token.activated, api_token.deleted, team_member.added,
# team_member.signed_in, team_member.signed_out.
# poll.vote.added and poll.vote.removed are required. /api/health reports
# linqWebhooks: missing_poll_vote when the live subscription lacks either.
#   ["message.sent", "message.received", "message.read", "message.delivered",
#    "message.failed", "message.edited",
#    "reaction.added", "reaction.removed",
#    "poll.received", "poll.failed", "poll.sent", "poll.delivered", "poll.read",
#    "poll.updated", "poll.vote.added", "poll.vote.removed", "poll.reaction.added",
#    "participant.added", "participant.removed",
#    "chat.created", "chat.group_name_updated", "chat.group_icon_updated",
#    "chat.group_name_update_failed", "chat.group_icon_update_failed",
#    "chat.background_updated", "chat.background_update_failed",
#    "chat.typing_indicator.started", "chat.typing_indicator.stopped",
#    "phone_number.status_updated", "phone_number.assigned", "phone_number.released",
#    "contact_card.received",
#    "call.initiated", "call.ringing", "call.answered", "call.ended",
#    "call.failed", "call.declined", "call.no_answer",
#    "location.sharing.started", "location.sharing.stopped",
#    "payment.succeeded", "payment.canceled", "payment.expired",
#    "payment.declined", "payment.authorized",
#    "connection.created", "connection.revoked",
#    "zero_day_retention.updated", "phone_number.forwarding_updated",
#    "environment.line_moved",
#    "contact_card.created", "contact_card.updated", "contact_card.deleted",
#    "environment.created", "environment.renamed", "environment.deleted",
#    "webhook_subscription.created", "webhook_subscription.deleted",
#    "webhook_subscription.target_url_changed", "webhook_subscription.enabled",
#    "webhook_subscription.disabled", "webhook_subscription.events.updated",
#    "webhook_subscription.phone_numbers.updated",
#    "webhook_subscription.routing_headers_set",
#    "webhook_subscription.routing_headers_cleared"]
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
# The Hale line that opens a co-parent group and owns the Name and Photo card.
# E.164. Must match NEXT_PUBLIC_HALE_SMS_NUMBER (the public Linq line). Never
# hardcoded. Absent means groups are skipped (no_from) and the contact card
# is not shared.
LINQ_FROM_E164=
# Polls are off unless this is exactly `on`. Design locked the year-find ask:
# after a find with 2+ hits, in that same Linq thread, one question
# ("Which of these should I look at first?" / "Lequel je regarde en premier?")
# whose options are up to 3 titles from that find plus "None of these" /
# "Aucun de ceux-la". Empty finds, conflicts, handoffs, and receipts do not
# poll. Leave this unset in this change. Turn LINQ_POLLS on after the poll
# PR ships.
LINQ_POLLS=
# Parent-made polls in a Linq group (VIL-471). Off unless this is exactly
# `true`. The native poll card additionally needs LINQ_POLLS. Apply
# migration 0190 first.
LINQ_GROUP_POLLS_ENABLED=
# After a household says yes to a tracked group plan, Hale asks before writing
# that household's calendar (VIL-503). Counts only when this is exactly `true`
# AND VERCEL_ENV is `preview`. A copy of the var in production does nothing.
# Needs the group-plan RSVP flag as well, and migration 0210. Leave unset
# until Design lights Preview.
LINQ_GROUP_PLAN_RSVP_CALENDAR_ENABLED=
# In-group co-parent seating and dual-calendar notices on the Linq channel.
# On unless this is exactly `off` (kill switch). SMS co-parent invites are
# unchanged either way. Apply migration 0132 before the first noted co-parent
# message, because the flag defaults on.
LINQ_GROUP_COPARENT=
# VIL-686 Secret Santa in a multi-family group: on unless this is exactly
# `false` (trimmed; kill switch). Needs LINQ_MULTI_FAMILY_GROUPS_ENABLED and
# migration 0245. Retention (delete-sweep) runs whatever it says.
SECRET_SANTA=
# VIL-661 split-duty day plan: two kids, overlapping activities, two drivers.
# Off unless this is exactly `true` (no trim). The allowlist can name families
# while the global flag is still off.
COPARENT_SPLIT_DUTY_ENABLED=
COPARENT_SPLIT_DUTY_FAMILY_ALLOWLIST=
# Shared Linq groups with more than one family (VIL-399). Off unless this is
# exactly `true`. Each family joins on its own. Hale does not put one family's
# memory, calendar, email, children, or signups into the shared thread.
LINQ_MULTI_FAMILY_GROUPS_ENABLED=
# Unlimited household-group seats on a participant add (VIL-398). Off unless
# this is `true` after trimming. Group onboarding v2 replaces this path.
LINQ_GROUP_MEMBERS_ENABLED=
# Group onboarding v2. Off unless this is `true` after trimming. On, Hale's own
# add to a group (or a group chat.created) reads who is in the chat into
# linq_group_rosters and claims it for the one family whose verified parent is
# in it. It seats nobody and sends nothing. Apply migration 0158 first.
LINQ_GROUP_ONBOARDING_V2_ENABLED=
# VIL-444 (T24) clash alerts in the household group. Off unless this is `true`
# after trimming. On, two kid plans at once (or the person taking one busy then)
# get one model-written alert naming who is free on the connected calendars, in
# place of the household conflict line. No poll. Needs CALENDAR_ALERT_ENABLED.
LINQ_GROUP_CONFLICT_ALERTS_ENABLED=
# iMessage screen and bubble effects (VIL-473). Off unless this is exactly
# `true` after trimming. Unset, empty, `on`, and `false` stay dark. Production
# may light it the same way as any other environment. This tree does not set
# the flag.
LINQ_EFFECTS_ENABLED=
# One coach answer as several short iMessage bubbles on a 1:1 chat. Off unless
# this is exactly `true`. Groups and SMS keep one text. Lit, every multi-bubble
# iMessage send for the family (coach answer, plan, notice, intake map) waits
# about 2s with typing up between bubbles. The allowlist names families
# (comma-separated ids) that get it while the flag is off.
COACH_BUBBLES_ENABLED=
COACH_BUBBLES_FAMILY_ALLOWLIST=
# iMessage @mentions in Linq group chats (VIL-475). Off unless this is `true`
# after trimming AND VERCEL_ENV is exactly `preview`. Production stays dark
# even when this is `true`. On, inbound mentions become facts for the
# group-turn reader, and a group reply may carry one outbound mention when
# the model names a seated member. Leave this unset.
LINQ_GROUP_MENTIONS_ENABLED=
# Public HTTPS turtle image for the contact card and the group icon. Defaults
# to https://app.villagehale.com/email-logo.png (the welcome-mail mark). Linq
# fetches this URL itself, so a local path cannot be the photo.
LINQ_CONTACT_IMAGE_URL=

# Master switch for sending the daily-brief email. Off unless set to exactly
# 'true' — composing + storing the brief is unaffected; only the outbound send is
# gated. Keep OFF until the sending domain is verified, then flip deliberately.
DIGEST_SEND_ENABLED=false
# Signs CASL one-click unsubscribe links (HMAC). Without it, briefs are NOT sent
# (no compliant unsubscribe link can be minted). Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# ─── Scheduled agents (Vercel Cron) ───────────────────────────────────────
# Shared secret the cron routes (apps/web/app/api/cron/*) require as
# `Authorization: Bearer <CRON_SECRET>`. Vercel injects it automatically on cron
# invocations; without a match the route 401s and does no work (no spend).
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Arms the orphan-user erasure sweep, a leg of /api/cron/delete-sweep. OFF unless set
# to exactly 'true' (set it with `printf '%s'` — a piped `echo` stores a trailing
# newline and the flag silently stays off). OFF is OBSERVE-ONLY, not skipped: the
# sweep selects its candidates exactly as it would and writes nothing, reporting the
# count it WOULD have anonymised as `orphans.observedOnly` and logging one line. Read
# that number for a night before arming — what the sweep does (name, email and
# sign-in identity to null) is irreversible, and its first tick meets every co-parent
# who ever departed and every caregiver whose grant was revoked, all at once.
ORPHAN_USER_SWEEP_ENABLED=false

# ─── Encryption (column-level envelope encryption) ────────────────────────
# 32-byte base64-encoded key; rotate quarterly
APP_ENCRYPTION_KEY=
# Where the ciphertext rests, written into the connector custody descriptor
# (integrations/token-vault.ts) so a residency question is answerable from the audit
# row. Unset reads as 'unnamed' — an absence said out loud, never a region assumed.
DATA_RESIDENCY_REGION=

# ─── Observability ────────────────────────────────────────────────────────
# Error tracking lives in PostHog (exceptions + linked session replay) — see the
# PostHog block below; there is no separate error-tracking key.
# Monthly Anthropic spend (sum of agent_runs.cost_usd) at which the hourly
# /api/cron/spend-alert route pages Slack #ops once per 24 h. Unset (or not a number
# above 0) = threshold_not_configured, logged, no page. It sums agent_runs only, so it
# undercounts console spend and is not an early warning for the usage-limit 400.
ANTHROPIC_SPEND_ALERT_USD=200

# Autonomous execution (rule #4: opted-in, 5-streak action types). Off unless the
# value is exactly `true`, untrimmed (a trailing newline is off; set with printf);
# off holds each action for approval (audit action.gated.lane_off). A parent's own
# approval still executes. Leave it unset until Barton sets it. Even then, a kind
# does not run until the turn-on text has been delivered.
# AUTONOMOUS_EXECUTE_ENABLED=true

# Ended Google Calendar items skip the LLM classifier. Default ON. The literal
# false (surrounding whitespace trimmed) sends those items through the classifier.
# GCAL_PAST_CLASSIFY_SKIP=false

# ─── Product analytics + replay + errors (PostHog) ────────────────────────
# Client-side, privacy-first. Absent key = clean no-op (DNT respected, nothing
# sent). Browser capture (pageviews, autocapture, replay, heatmaps, surveys) is
# also dark unless NEXT_PUBLIC_POSTHOG_WEB_ENABLED is exactly `true`. Replay is
# a second exact-`true` flag. Unset / TRUE / true\n / 1 all stay off. Turn both
# on in Prod after merge, then redeploy apps/web AND apps/site.
# HOST picks the region: https://us.i.posthog.com or https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Launch flags (apps/web + apps/worker). Off unless POSTHOG_FLAGS_ENABLED is
# exactly `true` — while off, every flag is today's env read. The env value
# `false`/`off` is the kill even when PostHog would return true.
# POSTHOG_FEATURE_FLAGS_KEY is a personal / feature-flags secure API key for
# local evaluation (not the project token). POSTHOG_ID_SALT HMAC-SHA256s the
# family id used as distinct_id and the `family` group.
# POSTHOG_PERSONAL_API_KEY + POSTHOG_PROJECT_ID are the sync-script credentials
# (`pnpm --filter @hale/flags sync -- --dry`).
# POSTHOG_FLAGS_ENABLED=
# POSTHOG_FEATURE_FLAGS_KEY=
# POSTHOG_ID_SALT=
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# NEXT_PUBLIC_POSTHOG_WEB_ENABLED=true
# NEXT_PUBLIC_POSTHOG_REPLAY_ENABLED=true
# Server-only salt for HMAC-SHA256 of the family id before it is passed to the
# browser as the PostHog distinct id. Choose once; never rotate (that forks
# every person). Unset, hashFamilyId keeps the historical unsalted sha256 so
# existing SMS-side rows still join. Never a phone number.
# POSTHOG_ID_SALT=
# LLM-generation tracing ($ai_generation). Separate from the product key above.
# Hale calls Anthropic directly, not the AI Gateway, so this must be set on BOTH
# apps/web AND apps/worker for every call site to emit cache_creation, cache_read,
# input tokens, and hale_stage. Absent = dark (no events in 30 days). Use a
# PostHog project API key, never NEXT_PUBLIC_POSTHOG_KEY.
# POSTHOG_PROJECT_API_KEY=
# Optional host override; defaults to NEXT_PUBLIC_POSTHOG_HOST or us.i.posthog.com.
# POSTHOG_HOST=https://us.i.posthog.com
# HMAC-SHA256 salt for the family id sent as distinct_id. Unset = distinct_id is
# `system`; never the raw family id. Set on BOTH apps/web AND apps/worker in Prod.
# POSTHOG_ID_SALT=
# Prompt/completion bodies on $ai_generation. Exact `true` turns it on (default off).
# Phones, emails, and street addresses are redacted first. Turn on in Prod only.
# POSTHOG_LLM_CONTENT_ENABLED=true

# Server-side launch product events + error tracking (posthog-node). All three
# flags default off: unset is not true. Prod turns them on after merge.
# HMAC-SHA256 of family / group-chat ids; never a phone, a name, or message text.
# POSTHOG_PROJECT_API_KEY is the error-tracking + LLM-trace project (may share
# the product project). POSTHOG_ID_SALT is required for launch events.
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_ID_SALT=
# POSTHOG_PRODUCT_EVENTS_ENABLED=
# POSTHOG_ERROR_TRACKING_ENABLED=
# POSTHOG_OPS_ALERTS_ENABLED=
# POSTHOG_UNANSWERED_AFTER_MINUTES=15

# ─── Internal service-to-service auth ─────────────────────────────────────
INTERNAL_API_SHARED_SECRET=

# ─── Authorized signup browser runtime (VIL-395) ──────────────────────────
# Both flags stay off until Barton arms them. Neither value is set here.
# AUTHORIZED_SIGNUP_ENABLED must be exactly `on` (trim is allowed on that one).
# SIGNUP_SANDBOX_RUNTIME_ENABLED must be exactly `true` — a trailing newline
# stays off. Set it with printf '%s', never a piped echo.
# SIGNUP_BROWSER_RUNTIME is exactly local, vercel_sandbox, or browserbase.
# browserbase is an empty slot (skipped: not_built) and does not call out.
# vercel_sandbox also needs SIGNUP_BROWSER_SNAPSHOT_ID (a snapshot Barton
# creates in his own Vercel account, in Montreal / yul1, with playwright and
# Chromium already installed) and either VERCEL_OIDC_TOKEN or
# VERCEL_TOKEN + VERCEL_TEAM_ID + VERCEL_PROJECT_ID. The adapter always
# requests region yul1 and does not fall back to iad1. This repo does not
# create that account or that snapshot.
# SIGNUP_SANDBOX_RUNTIME_ENABLED=
# SIGNUP_BROWSER_RUNTIME=
# SIGNUP_BROWSER_SNAPSHOT_ID=

# Browser Use Cloud signup engine (T8). Off unless exactly `true`; also needs
# AUTHORIZED_SIGNUP_ENABLED=on. Without payment it stops at checkout and the parent pays.
# BROWSER_USE_SIGNUP_PAYMENT_ENABLED (exact `true`) lets the agent pay with the parent's
# own Stripe Link Agent Wallet after they approve in Link. Keys stay server-side.
# It also gates the day-before plan lane's payment with the card saved on the parent's
# city account: off, a plan stops at checkout (`payment_off`) and the parent pays on the
# live browser. ENV-ONLY — never a PostHog flag. LINQ_APP_CLIP_PAY_ENABLED is the same: env-only and
# stays OFF. Code still stops before any payment > $0 and caps a signup run at $3.
# LINK_OAUTH_CLIENT_ID / LINK_OAUTH_CLIENT_SECRET come from Stripe's Link Agent Wallet
# application; the token call also uses STRIPE_PUBLISHABLE_KEY.
# BROWSER_USE_SIGNUP_ENABLED=
# BROWSER_USE_SIGNUP_PAYMENT_ENABLED=
# REGISTRATION_PLAN_RUN_ENABLED (exact `true`) carries out parents' day-before plans at
# the open on the towns in apps/web/lib/signup/plan/towns.ts. Its own kill switch.
# Arm only once Browser Use's CAPTCHA solver is off for plan runs (see
# docs/flag-rollout-checklist.md).
# REGISTRATION_PLAN_RUN_ENABLED=
# REGISTRATION_ASSISTED_RUN_ENABLED (exact `true`) adds the ActiveNet towns to the plan lane in
# assisted mode: Hale fills the registration at the open and texts the parent the live browser
# to submit and pay. Needs REGISTRATION_PLAN_RUN_ENABLED too. Same CAPTCHA condition.
# REGISTRATION_ASSISTED_RUN_ENABLED=
# LINK_OAUTH_CLIENT_ID=
# LINK_OAUTH_CLIENT_SECRET=
# BROWSER_USE_API_KEY=
#
# Browser Use watch: hourly cron re-reads provider pages (schedules, openings, waitlists)
# with one saved script per provider workspace. Off unless exactly `true`. Spend caps
# are in apps/web/lib/signup/browser-use/watch/sweep.ts.
# BROWSER_USE_WATCH_ENABLED=

# ─── Interest passport (VIL-106) ──────────────────────────────────────────
# Off unless this is exactly `true`. A trailing newline stays off.
# INTEREST_PASSPORT_ENABLED=
# INTEREST_PASSPORT_DEMO is preview-only. It does nothing unless VERCEL_ENV is
# exactly `preview` (Vercel sets that; production is `production`) AND
# INTEREST_PASSPORT_ENABLED is exactly `true` AND this is exactly `true`.
# Then /demo/passport, /family, and /family/preview-mia serve the Mia and Leo
# fixture with no session and no database. Do not set it on production.
# INTEREST_PASSPORT_DEMO=

# ─── Age-fit correction (VIL-568) ─────────────────────────────────────────
# Off unless this is exactly `true` (no trim). A trailing newline stays off.
# Lit, the 1:1 coach and the onboarding friend take a parent's correction that
# a named program does not fit a child, and stop offering that program. The
# model writes the reply. Dark leaves those skill bytes (and eval cache keys)
# unchanged. Set it with printf '%s', never a piped echo. Sloane lights it.
# AGE_FIT_CORRECTION_ENABLED=

# ─── 1:1 coach: never offer or agree to tell the group (VIL-577) ───────────
# Off unless this is exactly `true` (no trim). A trailing newline stays off.
# Lit, the 1:1 coach never offers to tell the group for a family, and does not
# promise a group post if they ask or say yes. Hale has no path from a 1:1
# reply into the group. They tell the group themselves. The model writes the
# reply. Dark leaves the coach skill bytes (and eval cache keys) unchanged.
# The private aside already never offers. Set it with printf '%s', never a
# piped echo. Sloane lights it.
# GROUP_1TO1_NO_GROUP_RELAY_ENABLED=

# ─── Holding line (slow-answer cover line) ────────────────────────────────
# Off unless this is exactly `true` (no trim). A trailing newline stays off.
# Set it with printf '%s', never a piped echo. Barton lights it.
# HOLDING_LINE_ENABLED=
# Comma-separated family ids lit while HOLDING_LINE_ENABLED is unset.
# HOLDING_LINE_FAMILY_ALLOWLIST=

# ─── Deep follow-up now (the answer to "I'll come back to you") ───────────
# Off unless this is exactly `true` (no trim). Lit, an activity promise is
# researched at question time and the answer goes out on the immediate lane,
# threaded under the parent's ask in their 1:1 iMessage chat, in the language
# of that ask. Dark, nothing is queued: the hourly sweep answers the promise at
# its 24-hour due time, unthreaded, in the parent's stored language.
# Set it with printf '%s', never a piped echo. Barton lights it.
# DEEP_FOLLOWUP_NOW_ENABLED=
# Comma-separated family ids lit while DEEP_FOLLOWUP_NOW_ENABLED is unset.
# DEEP_FOLLOWUP_NOW_FAMILY_ALLOWLIST=

# ─── Back-to-back texts read as one turn (VIL-679) ────────────────────────
# 1:1 texts a parent sends seconds apart are read together: a short settle, a
# Haiku grouping read, one answer per ask. Off unless exactly `true`. The family
# allowlist (comma-separated family ids) lights it for those families only. Set
# it with printf '%s', never a piped echo. Noah lights it.
# INBOUND_BURST_ENABLED=
# INBOUND_BURST_FAMILY_ALLOWLIST=

# ─── Inbound photo facts (VIL-413) ────────────────────────────────────────
# A 1:1 photo or PDF a parent sends after signup is read into facts for the
# coach. Strict `true`. Unset: images reach the coach as before, PDFs stay unread.
# INBOUND_PHOTO_FACTS_ENABLED=

# ─── Audit log audience (VIL-635) ─────────────────────────────────────────
# Off unless this is exactly `true` (no trim). A trailing newline stays off.
# Lit, History and the access export show a one-adult audit row only to that
# adult. Unlit they keep the family-wide reads. Writers always set the column.
# Set it with printf '%s', never a piped echo.
# AUDIT_LOG_AUDIENCE_ENABLED=
# ─── Access export round 2 (VIL-638) ──────────────────────────────────────
# Off unless this is exactly `true` (no trim). A trailing newline stays off.
# Lit, the right-to-access copy leaves coach-only held notes out of the
# requester thread, scopes bookings to the requesting adult, redacts a 13+
# child's booking title, genericizes a sensitive household calendar row,
# carries the source-changed columns, and the privacy page says removed
# lines are in the copy. Set it with printf '%s', never a piped echo.
# ACCESS_EXPORT_ROUND_2_ENABLED=

# ─── Shared teen-name matcher (VIL-634) ───────────────────────────────────
# Off unless this is exactly `true` (no trim). A trailing newline stays off.
# Lit, every gate that hides a 13+ child's title or text uses namesAny
# (accents, format characters, every name part of two or more letters).
# Unlit, those gates keep the pre-VIL-634 whole-word check. Set it with
# printf '%s', never a piped echo.
# TEEN_NAME_SHARED_MATCHER_ENABLED=

# ─── Live search for off-topic answers ────────────────────────────────────
# Off unless this is exactly `true` (no trim). A trailing newline stays off.
# Lit, an off-topic question whose answer turns on something current is
# looked up with Anthropic web search (billed per search) before Hale
# answers. The search is sent the de-identified question, today's date and,
# only when the answer depends on where the family is, their city and
# country, with the province or state when the city's name alone is more
# than one place. Never the postal code or anything else about them. Lit, a
# reply that left a question open keeps it, de-identified, in a table of its
# own until Hale next replies to that parent, or the hourly sweep finds a
# newer word from Hale has closed it (migration 0167: apply it before
# lighting this; the deploy itself does not wait on it).
# Unlit, Hale says it cannot check right now. Set it with printf '%s', never
# a piped echo. Barton lights it.
# GENERAL_ANSWER_SEARCH_ENABLED=
