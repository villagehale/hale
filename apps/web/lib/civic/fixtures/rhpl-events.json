      "6a637a479e0a050e3e541fdc": {
        "id": "6a637a479e0a050e3e541fdc",
        "key": "2026-10-05T16:00:00",
        "seriesId": "6a637a439e0a050e3e541fd8",
        "definition": {
          "start": "2026-10-05T16:00",
          "end": "2026-10-05T17:00",
          "title": "Let's Explore Art! (6–8 yrs)",
          "description": "<p><strong>Ages: 6–8 years</strong></p>\n<p><strong></strong>Young artists are invited to get messy, experiment, and create using a variety of materials. Each week, we’ll dive into a different technique—from pastels to mosaics, or something completely new. Try different techniques, learn new skills, and unleash their creativity in a fun, supportive environment.<br></p>\n",
          "partnerId": null,
          "bibIds": [],
          "featuredImageId": "6a637a06d23de82955c8eec9",
          "branchLocationId": "CENTRAL",
          "nonBranchLocationId": null,
          "locationDetails": "Location: Room A, 2nd Floor.",
          "audienceIds": [
            "654d1043eb28943d007702a3"
          ],
          "languageIds": [
            "654d107a61803d36006c4efc"
          ],
          "programId": null,
          "typeIds": [
            "65c25b15f797a6fee574563d"
          ],
          "registrationInfo": {
            "provider": "BIBLIO_EVENTS",
            "registrationStart": {
              "unit": "days",
              "date": "2026-08-14",
              "time": "T09:30",
              "ordinal": 0,
              "windowType": "STATIC"
            },
            "registrationEnd": {
              "unit": "hours",
              "date": null,
              "time": null,
              "ordinal": 24,
              "windowType": "RELATIVE"
            },
            "enabledMethods": [],
            "cap": 12,
            "maxSeats": 2,
            "scope": null,
            "isFull": false,
            "instructions": null,
            "onlineInstructions": "<p>Thank you for registering for the upcoming event, Let's Explore Art!, at Richmond Hill Public Library. We're delighted to have you join us for this exciting program.</p>\n<p>This program is for <strong>ages 6-8 years</strong>.&nbsp;</p>\n<p>Please arrive early so you don't miss any part of the event.</p>\n<p>If you have any questions or need further information before the event, reach out to our team at <a href=\"mailto:communityengagement@rhpl.ca\" target=\"_blank\">communityengagement@rhpl.ca</a>.</p>\n<p>Share your RHPL experience by answering this two-question survey:<a href=\"https://www.surveymonkey.com/r/rhplfeedback\"> https://www.surveymonkey.com/r/rhplfeedback</a></p>\n<p><a href=\"https://confirmsubscription.com/h/j/35F6368CCEE98AE0\">Subscribe to our e-newsletter</a> for the latest library news and upcoming events.</p>",
            "instructionsToAttend": "<p>Your event is coming up at Richmond Hill Public Library. We’re delighted to have you join us for this program. Below are the event details:</p>\n<p>Event Details:</p>\n<ul><li>Event Name: Let's Explore Art!</li><li>Ages: 6-8 yrs</li><li>Date: Monday, Oct. 5<br></li><li>Time: 4–5 PM.</li><li>Location: Room A, 2nd Floor, Central Branch</li></ul>\n<p>Participants are asked to arrive early to the event. If you arrive late, admission will be at the discretion of the presenter.&nbsp;</p>\n<p><strong>Please note:</strong> Kids and teen programs have specific age requirements and registrants may be turned away if their child is not in the desired age group.</p>\n<p>If you have any questions or need further information before the event, reach out to our team at <a href=\"mailto:communityengagement@rhpl.ca\" target=\"_blank\">communityengagement@rhpl.ca</a>.</p>\n<p>We look forward to sharing this experience with you and hope you enjoy the event.</p>",
            "loginToRegister": false,
            "waitlistEnabled": true,
            "waitlistAutoPromote": true
          },
