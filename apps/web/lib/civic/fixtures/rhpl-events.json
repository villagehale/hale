          "registrationInfo": {
            "waitlistEnabled": false,
            "loginToRegister": false,
            "instructionsToAttend": null,
            "onlineInstructions": null,
            "instructions": "<p>Register for the whole series&nbsp;through <a href=\"https://www.eventbrite.ca/e/wordplay-story-writing-workshop-9-12-yrs-tickets-1989914586094?aff=BiblioEvents\" target=\"_blank\">Eventbrite</a>. Registration opens on <strong>Friday, Jun. 12&nbsp;</strong>at 9:30 a.m.</p>",
            "isFull": false,
            "scope": null,
            "maxSeats": null,
            "cap": null,
            "enabledMethods": [],
            "registrationEnd": {
              "windowType": null,
