{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && rm -rf packages/*/dist packages/*/*.tsbuildinfo packages/*/tsconfig.tsbuildinfo && pnpm turbo build --filter=@hale/web --force",
  "regions": ["yul1"],
  "crons": [
    { "path": "/api/cron/week-plan", "schedule": "2 * * * *" },
    { "path": "/api/cron/sunday-send", "schedule": "7 * * * *" },
    { "path": "/api/cron/reminders", "schedule": "12 * * * *" },
    { "path": "/api/cron/registration-sequence", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/nudge", "schedule": "17 * * * *" },
    { "path": "/api/cron/party-reminders", "schedule": "22 * * * *" },
    { "path": "/api/cron/spend-alert", "schedule": "27 * * * *" },
    { "path": "/api/cron/delete-sweep", "schedule": "32 * * * *" },
    { "path": "/api/cron/attachment-sweep", "schedule": "37 * * * *" },
    { "path": "/api/cron/inference", "schedule": "42 6 * * *" },
    { "path": "/api/cron/discovery", "schedule": "47 13 * * 1" },
    { "path": "/api/cron/loop-health-digest", "schedule": "52 14 * * 1" },
    { "path": "/api/cron/civic-sweep", "schedule": "57 15 * * 1" },
    { "path": "/api/cron/registration-verify", "schedule": "3 16 * * 1" },
    { "path": "/api/cron/drain", "schedule": "* * * * *" },
    { "path": "/api/cron/queue-maintenance", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/connector-sync", "schedule": "*/15 * * * *" }
  ]
}
