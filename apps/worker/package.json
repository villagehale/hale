{
  "name": "@hale/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./orchestrator": "./src/orchestrator/index.ts",
    "./reviewer": "./src/agents/reviewer.ts",
    "./redaction": "./src/redaction/redact.ts",
    "./executor": "./src/services/executor.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:classifier": "node evals/run-eval.mjs --cached-only",
    "eval:drafter": "node evals/run-drafter-eval.mjs --cached-only",
    "eval:memory": "node evals/run-memory-eval.mjs --cached-only",
    "eval:memory-writeback": "node evals/run-memory-writeback-eval.mjs --cached-only",
    "eval:agents": "node evals/run-agent-eval.mjs --cached-only",
    "eval:week-summary": "node evals/run-agent-eval.mjs --cached-only --suite=week-summary",
    "eval:reviewer": "node evals/run-reviewer-eval.mjs --cached-only",
    "eval:village-search": "node evals/run-village-search-eval.mjs --cached-only",
    "eval:sentinel": "node evals/run-sentinel-eval.mjs --cached-only",
    "eval:intake": "node evals/run-intake-eval.mjs --cached-only",
    "eval:intake-voice": "node evals/run-intake-voice-eval.mjs --cached-only",
    "eval:intake-answer": "node evals/run-intake-answer-eval.mjs --cached-only",
    "eval:inbound-lane": "node evals/run-inbound-lane-eval.mjs --cached-only",
    "eval:general-answer": "node evals/run-general-answer-eval.mjs --cached-only",
    "eval:medical-symptom": "node evals/run-medical-symptom-eval.mjs --cached-only",
    "eval:activity-finder": "node evals/run-activity-finder-eval.mjs --cached-only",
    "eval:activity-deep": "node evals/run-activity-deep-eval.mjs --cached-only",
    "eval:turn-apology": "node evals/run-turn-apology-eval.mjs --cached-only",
    "eval:followup-voice": "node evals/run-followup-voice-eval.mjs --cached-only",
    "eval:calendar-voice": "node evals/run-calendar-voice-eval.mjs --cached-only",
    "eval:identity-ask": "node evals/run-identity-ask-eval.mjs --cached-only",
    "eval:reminder-voice": "node evals/run-reminder-voice-eval.mjs --cached-only",
    "eval:intro-voice": "node evals/run-intro-voice-eval.mjs --cached-only",
    "eval:reply-resolver": "node evals/run-reply-resolver-eval.mjs --cached-only",
    "eval:radar": "node evals/run-radar-eval.mjs --cached-only",
    "eval:nudge": "node evals/run-nudge-eval.mjs --cached-only",
    "eval:rsvp": "node evals/run-rsvp-eval.mjs --cached-only",
    "eval:coach-channel": "node evals/run-coach-channel-eval.mjs --cached-only",
    "eval:voice-turn": "node evals/run-voice-turn-eval.mjs --cached-only",
    "eval:coach-plan": "node evals/run-coach-plan-eval.mjs --cached-only",
    "eval:civic-hours": "node evals/run-civic-hours-eval.mjs --cached-only",
    "eval:registration-verify": "node evals/run-registration-verify-eval.mjs --cached-only",
    "eval:vil143": "node evals/run-vil143-eval.mjs",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "prompts:push": "node scripts/sync-prompts.mjs push",
    "prompts:pull": "node scripts/sync-prompts.mjs pull",
    "prompts:check": "node scripts/sync-prompts.mjs check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.41.0",
    "@hale/agent": "workspace:*",
    "@hale/db": "workspace:*",
    "@hale/tools-contracts": "workspace:*",
    "@hale/types": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "pg-boss": "^10.1.6",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "resend": "^6.14.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.10.5",
    "langfuse": "^3.38.20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
